# Python bytecode and caches
__pycache__/
*.py[cod]
*.pyd

# Virtual environments
.venv/
venv/
env/

# Packaging / build artifacts
build/
dist/
*.egg-info/

# Test and type-check caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/

# Coverage
.coverage
.coverage.*
htmlcov/

# Notebook checkpoints
.ipynb_checkpoints/

# VS Code state
.vscode/*.log

# OS cruft
.DS_Store
Thumbs.db

# Source datasets. Never committed: multi-GiB, and provenance lives in
# data/metadata/catalog.json (source URL + SHA-256) instead of in the repo.
# Resolved at runtime via COMPRESSION_BENCH_DATA_ROOT (default: this directory).
data/raw/

# Generated test scratch (leading underscore = regenerated on every run).
# _fuzz_child.py is written from a template with an absolute host path baked in,
# so a committed copy churns per machine and is stale by definition.
# Preserved crash fixtures (tests/fixtures/fuzz_*.parquet) ARE evidence — keep those.
tests/_fuzz_child.py
tests/fixtures/_fuzz_case.parquet
